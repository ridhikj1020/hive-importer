# Server-side only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Set the same variables in Vercel: Project Settings, Environment Variables.

# Supabase: click Connect on the project, copy the "Transaction pooler" connection string
# (port 6543), and put your database password in place of [YOUR-PASSWORD].
DATABASE_URL=

# Local trial without Supabase (npm run dev:db), uncomment both lines:
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres
# DATABASE_SSL=disable
